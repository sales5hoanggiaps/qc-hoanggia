# --- Đồng bộ mã hàng/khách hàng/đơn hàng từ MISA AMIS CRM Open API ---
# Lấy tại AMIS CRM: ⚙️ Cài đặt → Kết nối/API → khai báo AppID để có Mã bảo mật.
# Có thể dùng chung AppID với dự án hoanggia-crm (APP QUẢN LÝ) nếu công ty chỉ đăng ký 1 App.
AMIS_APP_ID=
AMIS_CLIENT_SECRET=
AMIS_BASE_URL=https://crmconnect.misa.vn
AMIS_SYNC_CRON=0 2 * * *
AMIS_SYNC_CRON_TIMEZONE=Asia/Ho_Chi_Minh

# --- Database ---
DATABASE_URL=

# --- Session ---
SESSION_SECRET=

# --- Object storage (ảnh/video/tài liệu) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
