generator client {
  provider = "prisma-client-js"
  // "native" keeps local dev (Windows/macOS/glibc-linux) working; the
  // musl target is required to run inside the node:20-alpine Docker image,
  // whose Alpine base ships OpenSSL 3.x only (no libssl.so.1.1 compat
  // package available) — without pinning this, Prisma guesses the wrong
  // engine variant and every DB query fails at runtime inside the container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  QC_STAFF
  MANAGER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  PENDING_QC
  DISCONTINUED
}

/// Nhóm sản phẩm — 3 lựa chọn cố định (khác Category/"Loại sản phẩm", vốn là 1 danh sách
/// admin tự thêm được). Gán tay, không đồng bộ từ AMIS — cùng nguyên tắc đã áp dụng cho Category.
enum ProductGroup {
  SAN_XUAT
  THUONG_MAI
  GIA_CONG
}

enum DocumentKind {
  COA
  MSDS
  ROHS
  OTHER
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Customer {
  id             String            @id @default(cuid())
  amisCustomerId String            @unique
  name           String
  products       ProductCustomer[]
}

model Product {
  id               String           @id @default(cuid())
  baseCode         String           @unique
  amisProductId    String           @unique
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  productGroup     ProductGroup?
  status           ProductStatus    @default(PENDING_QC)
  currentVersionId String?          @unique
  currentVersion   ProductVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions         ProductVersion[] @relation("AllVersions")
  customers        ProductCustomer[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductCustomer {
  productId     String
  customerId    String
  lastOrderDate DateTime?
  product       Product  @relation(fields: [productId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])

  @@id([productId, customerId])
}

model ProductVersion {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation("AllVersions", fields: [productId], references: [id])
  currentForProduct Product? @relation("CurrentVersion")
  versionNumber     Int
  amisProductId     String   @unique
  name              String
  description       String?
  isCurrent         Boolean  @default(true)
  createdByAmisSync Boolean  @default(true)
  /// Đánh dấu bởi worker sync khi tên AMIS trôi lớn so với phiên bản hiện
  /// hành lúc tạo (xem detectNameDrift, spec §12.1) — nội dung TCSP/QC/
  /// Packaging/Documents vẫn được kế thừa như bình thường, nhưng
  /// MANAGER/ADMIN cần xác nhận đã kiểm tra trước khi coi là đáng tin.
  needsInheritanceReview Boolean @default(false)
  createdAt         DateTime @default(now())

  tcsp       TCSPData?
  qc         QCData?
  packaging  PackagingData?
  documents  DocumentsData?
  changeLogs ChangeLogEntry[]

  @@unique([productId, versionNumber])
}

model TCSPData {
  id           String         @id @default(cuid())
  versionId    String         @unique
  version      ProductVersion @relation(fields: [versionId], references: [id])
  materialCode String?
  description  String?
  preparedBy   String?
  approvedBy   String?
  approvedAt   DateTime?
  specRows     TCSPSpecRow[]
  media        MediaAsset[]
}

model TCSPSpecRow {
  id        String   @id @default(cuid())
  tcspId    String
  tcsp      TCSPData @relation(fields: [tcspId], references: [id])
  groupName String
  criterion String
  value     String
  tolerance String?
  unit      String?
  note      String?
  sortOrder Int      @default(0)
}

model QCData {
  id           String         @id @default(cuid())
  versionId    String         @unique
  version      ProductVersion @relation(fields: [versionId], references: [id])
  checklist    String?
  knownDefects String?
  specialNotes String?
  media        MediaAsset[]
}

model PackagingData {
  id           String         @id @default(cuid())
  versionId    String         @unique
  version      ProductVersion @relation(fields: [versionId], references: [id])
  instructions String?
  specialNotes String?
  media        MediaAsset[]
}

model DocumentsData {
  id        String            @id @default(cuid())
  versionId String            @unique
  version   ProductVersion    @relation(fields: [versionId], references: [id])
  files     ProductDocument[]
}

model ProductDocument {
  id          String        @id @default(cuid())
  documentsId String
  documents   DocumentsData @relation(fields: [documentsId], references: [id])
  kind        DocumentKind
  label       String
  storageKey  String
  uploadedAt  DateTime      @default(now())
}

model MediaAsset {
  id          String @id @default(cuid())
  storageKey  String
  mimeType    String
  caption     String?
  sortOrder   Int     @default(0)

  tcspId      String?
  tcsp        TCSPData?      @relation(fields: [tcspId], references: [id])
  qcId        String?
  qc          QCData?        @relation(fields: [qcId], references: [id])
  packagingId String?
  packaging   PackagingData? @relation(fields: [packagingId], references: [id])
}

model ChangeLogEntry {
  id        String         @id @default(cuid())
  versionId String
  version   ProductVersion @relation(fields: [versionId], references: [id])
  fieldPath String
  oldValue  String?
  newValue  String?
  changedBy String?
  changedAt DateTime       @default(now())
  source    String
}

model SyncLog {
  id                   String    @id @default(cuid())
  startedAt            DateTime  @default(now())
  finishedAt           DateTime?
  newProducts          Int       @default(0)
  updatedLinks         Int       @default(0)
  newVersions          Int       @default(0)
  flaggedReview        Int       @default(0)
  /// Số mã AMIS bị bỏ qua vì versionNumber đã tồn tại sẵn cho baseCode đó (xem
  /// upsert-product.ts's `existingWithSameNumber` — không tạo ProductVersion mới, cần
  /// MANAGER/ADMIN rà soát thủ công xem có phải mã gốc bị dùng lại hay không, spec §12).
  duplicateVersionCodes Int      @default(0)
  errorMessage         String?
}
